# Copy to .env.local and fill in. Supabase values are under Project Settings > API Keys.
# .env.local is for testing (npm run dev, the web tests): use the testing Supabase project. The live project's
# values go in .env.production.local, which npm run build and npm start read first (see the README).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). The legacy "service_role" key also works. Server only, never share it.
SUPABASE_SECRET_KEY=

# Super admin password (the developer). Sign in at /admin/login?as=super to manage organizer
# accounts; organizers sign in with their own email and password.
ADMIN_PASSWORD=

# Random string of at least 32 characters used to sign session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Optional, only while changing SESSION_SECRET: the old value, so sessions it signed keep working until they run out
# (judges' last 3 days) instead of everyone being signed out at once. Remove it after that. See the README.
SESSION_SECRET_PREVIOUS=

# Optional. Public address for links and QR codes, e.g. https://scores.example.com
# Leave empty to use whatever address the admin opened the panel with.
NEXT_PUBLIC_SITE_URL=

# Optional. The test site tools (reset scores, delete mid-session) can wipe an event's scores, so production builds hide
# them unless this is on: Vercel previews, and `npm start` on a laptop at the venue (which uses the live database).
# Set it to on only for a build that uses the testing database: the Preview environment (see the README), and CI.
# The dev server always has them; the live Vercel site never does.
TEST_TOOLS=
